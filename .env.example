# Copy to .env and fill in. Never commit .env.
# Local Postgres, e.g. from: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:17
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/startupflow?schema=public"

# Python RAG service (ai/), started with: uvicorn startupflow_ai.api:app
AI_SERVICE_URL="http://127.0.0.1:8000"
