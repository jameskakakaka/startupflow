generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Startup {
  id        String   @id @default(uuid())
  name      String
  industry  String
  stage     String
  status    String
  score     Int
  createdAt DateTime @default(now())

  @@map("startups")
}
